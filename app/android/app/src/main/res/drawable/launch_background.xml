<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window background: the page gradient, nothing else.

     Cold start shows the launcher icon (the system splash on Android 12+, and
     LaunchScreen's centred icon on older versions); the poster belongs to a
     later launch, where Dart paints it (app/lib/launch/). Putting the poster
     here made every cold start flash it before the icon, which is not what it
     is for. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid fallback, the gradient's top colour, so no white flash. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/launch_background_top" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/launch_background_bottom"
                android:startColor="@color/launch_background_top"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
